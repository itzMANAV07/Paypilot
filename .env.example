# PayPal sandbox credentials
# Create a REST app at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Sandbox business account details (the invoice sender)
INVOICER_NAME=
INVOICER_EMAIL=

# Sandbox personal account email (the invoice recipient used in smoke test)
SANDBOX_RECIPIENT_EMAIL=

# AI provider config
# LLM_PROVIDER: openai | anthropic | google
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Set to true to enable the simulate-payment demo route
DEMO_MODE=true

